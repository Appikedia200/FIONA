'use client';

import { useState } from 'react';
import Link from 'next/link';
import useSWR, { mutate } from 'swr';
import apiClient from '@/lib/api-client';
import { Plus, Target, Play, Edit2, Trash2, Copy, ArrowLeft, X, ExternalLink, Eye, Download } from 'lucide-react';
import { toast } from 'sonner';

interface Campaign {
  id: string;
  name: string;
  targetUrl: string;
  description?: string;
  status: 'active' | 'inactive' | 'draft';
  domainId?: string;
  profileId?: string;
  addedById: string;
  createdAt: string;
  domain?: { id: string; name: string };
  profile?: { id: string; email: string };
  addedBy?: { id: string; fullName?: string; email: string; role: string };
}

interface Domain {
  id: string;
  name: string;
}

interface Profile {
  id: string;
  email: string;
}

const fetcher = async (url: string) => {
  const response = await apiClient.get(url);
  return response.data;
};

export default function AdminCampaignsPage() {
  const [showCreateDialog, setShowCreateDialog] = useState(false);
  const [showDeleteDialog, setShowDeleteDialog] = useState(false);
  const [campaignToDelete, setCampaignToDelete] = useState<Campaign | null>(null);
  const [creating, setCreating] = useState(false);
  const [deleting, setDeleting] = useState(false);
  const [launching, setLaunching] = useState<string | null>(null);
  const [previewCampaignId, setPreviewCampaignId] = useState<string | null>(null);
  const [previewCampaignName, setPreviewCampaignName] = useState<string>('');

  const [newCampaign, setNewCampaign] = useState({
    name: '',
    targetUrl: '',
    description: '',
    domainId: '',
    profileId: '',
  });

  const swrKey = '/api/campaigns';
  const { data, error, isLoading } = useSWR(swrKey, fetcher);
  const { data: domainsData } = useSWR('/api/admin/domains', fetcher);
  const { data: profilesData } = useSWR('/api/admin/profiles', fetcher);

  const campaigns: Campaign[] = data?.campaigns || [];
  const domains: Domain[] = domainsData?.domains || [];
  const profiles: Profile[] = profilesData?.profiles || [];

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newCampaign.name.trim() || !newCampaign.targetUrl.trim()) {
      toast.error('Name and Target URL are required');
      return;
    }

    setCreating(true);
    try {
      const response = await apiClient.post('/api/campaigns', {
        name: newCampaign.name.trim(),
        targetUrl: newCampaign.targetUrl.trim(),
        description: newCampaign.description.trim() || undefined,
        domainId: newCampaign.domainId || undefined,
        profileId: newCampaign.profileId || undefined,
      });

      if (response.status === 201) {
        toast.success('Campaign created successfully');
        setShowCreateDialog(false);
        setNewCampaign({ name: '', targetUrl: '', description: '', domainId: '', profileId: '' });
        mutate(swrKey);
      }
    } catch (error: any) {
      toast.error(error.response?.data?.error || 'Failed to create campaign');
    } finally {
      setCreating(false);
    }
  };

  const handleLaunch = async (campaignId: string) => {
    setLaunching(campaignId);
    try {
      const response = await apiClient.post(`/api/campaigns/${campaignId}/launch`);
      
      if (response.status === 200 && response.data) {
        const { sessionUrl, proxyUsed } = response.data;
        
        // Copy session URL to clipboard
        if (sessionUrl) {
          navigator.clipboard.writeText(sessionUrl);
          toast.success('Session started! Phishing URL copied to clipboard', {
            description: proxyUsed ? `Using proxy: ${proxyUsed}` : 'Direct connection',
          });
        } else {
          toast.success('Campaign launched successfully');
        }
        
        mutate(swrKey);
      }
    } catch (error: any) {
      toast.error(error.response?.data?.error || 'Failed to launch campaign');
    } finally {
      setLaunching(null);
    }
  };

  const handleDeleteClick = (campaign: Campaign) => {
    setCampaignToDelete(campaign);
    setShowDeleteDialog(true);
  };

  const handleDeleteConfirm = async () => {
    if (!campaignToDelete) return;

    setDeleting(true);
    try {
      const response = await apiClient.delete(`/api/campaigns/${campaignToDelete.id}`);
      
      if (response.status === 200) {
        toast.success('Campaign deleted successfully');
        setShowDeleteDialog(false);
        setCampaignToDelete(null);
        mutate(swrKey);
      }
    } catch (error: any) {
      toast.error(error.response?.data?.error || 'Failed to delete campaign');
    } finally {
      setDeleting(false);
    }
  };

  const getStatusBadge = (status: string) => {
    const styles: Record<string, { bg: string; text: string; label: string }> = {
      active: { bg: 'bg-emerald-500/10', text: 'text-emerald-400', label: 'Active' },
      inactive: { bg: 'bg-gray-500/10', text: 'text-gray-400', label: 'Inactive' },
      draft: { bg: 'bg-amber-500/10', text: 'text-amber-400', label: 'Draft' },
    };

    const style = styles[status] || styles.inactive;
    
    return (
      <span className={`inline-flex items-center rounded-full ${style.bg} px-2.5 py-0.5 text-xs font-medium ${style.text}`}>
        {style.label}
      </span>
    );
  };

  const getCreatorName = (campaign: Campaign) => {
    if (!campaign.addedBy) return 'Unknown';
    if (campaign.addedBy.role === 'ADMIN') return 'Admin';
    return campaign.addedBy.fullName || campaign.addedBy.email;
  };

  const handleDownload = async (campaignId: string) => {
    try {
      const response = await apiClient.get(`/api/campaigns/${campaignId}/download-page`, {
        responseType: 'blob',
      });

      const campaign = campaigns.find(c => c.id === campaignId);
      const filename = campaign 
        ? `${campaign.name.replace(/\s+/g, '-').toLowerCase()}-login-page.html`
        : 'campaign-login-page.html';

      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', filename);
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(url);

      toast.success('Campaign page downloaded');
    } catch (error: any) {
      toast.error('Failed to download campaign page');
    }
  };

  return (
    <div className="mx-auto max-w-7xl p-8">
      {/* Header */}
      <div className="flex items-center justify-between mb-8">
        <div>
          <Link href="/admin" className="flex items-center gap-1.5 text-sm text-white/60 hover:text-white transition-colors mb-3">
            <ArrowLeft className="h-3.5 w-3.5" />
            Back
          </Link>
          <div className="mb-2 text-sm text-white/50">
            <Link href="/admin" className="hover:text-white/70 transition-colors cursor-pointer">Admin</Link>
            <span> / </span>
            <span>Campaigns</span>
          </div>
          <h1 className="text-2xl font-semibold text-white">Campaigns</h1>
          <p className="mt-1 text-sm text-white/50">Manage all capture campaigns across technicians</p>
        </div>
        <button
          onClick={() => setShowCreateDialog(true)}
          className="flex items-center gap-2 rounded-lg bg-[#4F7FFF] px-4 py-2 text-sm font-medium text-white hover:bg-[#3d6ee0] transition-colors"
        >
          <Plus className="h-4 w-4" />
          Create Campaign
        </button>
      </div>

      {/* Stats */}
      <div className="grid grid-cols-4 gap-4 mb-8">
        <div className="rounded-xl border border-white/10 bg-[#151823] p-6">
          <p className="text-sm text-white/50">Total Campaigns</p>
          <p className="mt-2 text-3xl font-bold text-white">{campaigns.length}</p>
        </div>
        <div className="rounded-xl border border-white/10 bg-[#151823] p-6">
          <p className="text-sm text-white/50">Active</p>
          <p className="mt-2 text-3xl font-bold text-white">
            {campaigns.filter(c => c.status === 'active').length}
          </p>
        </div>
        <div className="rounded-xl border border-white/10 bg-[#151823] p-6">
          <p className="text-sm text-white/50">Inactive</p>
          <p className="mt-2 text-3xl font-bold text-white">
            {campaigns.filter(c => c.status === 'inactive').length}
          </p>
        </div>
        <div className="rounded-xl border border-white/10 bg-[#151823] p-6">
          <p className="text-sm text-white/50">Draft</p>
          <p className="mt-2 text-3xl font-bold text-white">
            {campaigns.filter(c => c.status === 'draft').length}
          </p>
        </div>
      </div>

      {/* Campaigns Table */}
      {isLoading ? (
        <div className="flex items-center justify-center p-12">
          <div className="h-8 w-8 border-2 border-[#4F7FFF] border-t-transparent rounded-full animate-spin" />
        </div>
      ) : campaigns.length === 0 ? (
        <div className="rounded-xl border border-white/10 bg-[#151823] p-12 text-center">
          <Target className="h-12 w-12 text-white/20 mx-auto mb-4" />
          <h3 className="text-lg font-medium text-white mb-2">No campaigns created yet</h3>
          <p className="text-sm text-white/50 mb-6">Create your first campaign to start capturing credentials</p>
          <button
            onClick={() => setShowCreateDialog(true)}
            className="inline-flex items-center gap-2 rounded-lg bg-[#4F7FFF] px-4 py-2 text-sm font-medium text-white hover:bg-[#3d6ee0] transition-colors"
          >
            <Plus className="h-4 w-4" />
            Create Campaign
          </button>
        </div>
      ) : (
        <div className="rounded-xl border border-white/10 bg-[#151823] overflow-hidden">
          <div className="flex items-center justify-between border-b border-white/10 px-6 py-4">
            <h2 className="text-sm font-medium text-white">All Campaigns</h2>
            <p className="text-xs text-white/50">{campaigns.length} total</p>
          </div>
          
          <table className="w-full">
            <thead>
              <tr className="border-b border-white/10 bg-white/5">
                <th className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-white/40">Campaign</th>
                <th className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-white/40">Target URL</th>
                <th className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-white/40">Status</th>
                <th className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-white/40">Domain</th>
                <th className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-white/40">Profile</th>
                <th className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-white/40">Created By</th>
                <th className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-white/40">Created</th>
                <th className="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-white/40">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-white/5">
              {campaigns.map((campaign) => (
                <tr key={campaign.id} className="hover:bg-white/5 transition-colors">
                  <td className="px-6 py-4">
                    <div className="font-medium text-white">{campaign.name}</div>
                    {campaign.description && (
                      <div className="text-xs text-white/50 mt-0.5">{campaign.description}</div>
                    )}
                  </td>
                  <td className="px-6 py-4">
                    <div className="flex items-center gap-2">
                      <span className="text-sm text-white/70 font-mono truncate max-w-xs">
                        {campaign.targetUrl}
                      </span>
                      <button
                        onClick={() => {
                          navigator.clipboard.writeText(campaign.targetUrl);
                          toast.success('URL copied');
                        }}
                        className="text-white/40 hover:text-white transition-colors"
                      >
                        <Copy className="h-3.5 w-3.5" />
                      </button>
                    </div>
                  </td>
                  <td className="px-6 py-4">{getStatusBadge(campaign.status)}</td>
                  <td className="px-6 py-4 text-sm text-white/60">
                    {campaign.domain ? campaign.domain.name : '—'}
                  </td>
                  <td className="px-6 py-4 text-sm text-white/60 font-mono">
                    {campaign.profile ? campaign.profile.email : '—'}
                  </td>
                  <td className="px-6 py-4 text-sm text-white/60">
                    {getCreatorName(campaign)}
                  </td>
                  <td className="px-6 py-4 text-sm text-white/60">
                    {new Date(campaign.createdAt).toLocaleDateString()}
                  </td>
                  <td className="px-6 py-4">
                    <div className="flex items-center justify-end gap-2">
                      <button
                        onClick={() => {
                          setPreviewCampaignId(campaign.id);
                          setPreviewCampaignName(campaign.name);
                        }}
                        title="Preview campaign page"
                        className="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-blue-400 hover:bg-blue-500/10 transition-colors"
                      >
                        <Eye className="h-3.5 w-3.5" />
                        Preview
                      </button>
                      <button
                        onClick={() => handleDownload(campaign.id)}
                        title="Download campaign page"
                        className="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-purple-400 hover:bg-purple-500/10 transition-colors"
                      >
                        <Download className="h-3.5 w-3.5" />
                        Download
                      </button>
                      <button
                        onClick={() => handleLaunch(campaign.id)}
                        disabled={launching === campaign.id || campaign.status === 'active'}
                        title={campaign.status === 'active' ? 'Already active' : 'Launch campaign'}
                        className="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-emerald-400 hover:bg-emerald-500/10 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                      >
                        <Play className={`h-3.5 w-3.5 ${launching === campaign.id ? 'animate-spin' : ''}`} />
                        Launch
                      </button>
                      <button
                        onClick={() => handleDeleteClick(campaign)}
                        disabled={deleting}
                        className="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-red-400 hover:bg-red-500/10 transition-colors disabled:opacity-50"
                      >
                        <Trash2 className="h-3.5 w-3.5" />
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* Create Campaign Modal */}
      {showCreateDialog && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
          <div className="w-full max-w-lg rounded-xl border border-white/10 bg-[#151823]">
            <div className="flex items-center justify-between border-b border-white/10 px-6 py-4">
              <h2 className="text-lg font-semibold text-white">Create Campaign</h2>
              <button
                onClick={() => setShowCreateDialog(false)}
                className="rounded-lg p-1.5 text-white/40 hover:bg-white/5 hover:text-white/70 transition-colors"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            <form onSubmit={handleCreate} className="p-6 space-y-4">
              <div>
                <label htmlFor="name" className="block text-sm font-medium text-white mb-2">
                  Campaign Name *
                </label>
                <input
                  id="name"
                  type="text"
                  value={newCampaign.name}
                  onChange={(e) => setNewCampaign({ ...newCampaign, name: e.target.value })}
                  placeholder="Q1 Phishing Assessment"
                  required
                  className="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-white placeholder:text-white/30 focus:border-[#4F7FFF] focus:outline-none"
                />
              </div>

              <div>
                <label htmlFor="targetUrl" className="block text-sm font-medium text-white mb-2">
                  Target URL *
                </label>
                <input
                  id="targetUrl"
                  type="url"
                  value={newCampaign.targetUrl}
                  onChange={(e) => setNewCampaign({ ...newCampaign, targetUrl: e.target.value })}
                  placeholder="https://accounts.google.com"
                  required
                  className="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-white placeholder:text-white/30 focus:border-[#4F7FFF] focus:outline-none"
                />
              </div>

              <div>
                <label htmlFor="description" className="block text-sm font-medium text-white mb-2">
                  Description (Optional)
                </label>
                <textarea
                  id="description"
                  value={newCampaign.description}
                  onChange={(e) => setNewCampaign({ ...newCampaign, description: e.target.value })}
                  placeholder="Campaign details..."
                  rows={3}
                  className="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-white placeholder:text-white/30 focus:border-[#4F7FFF] focus:outline-none resize-none"
                />
              </div>

              <div>
                <label htmlFor="domainId" className="block text-sm font-medium text-white mb-2">
                  Domain (Optional)
                </label>
                <select
                  id="domainId"
                  value={newCampaign.domainId}
                  onChange={(e) => setNewCampaign({ ...newCampaign, domainId: e.target.value })}
                  className="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:border-[#4F7FFF] focus:outline-none"
                >
                  <option value="">Select domain...</option>
                  {domains.map((domain) => (
                    <option key={domain.id} value={domain.id}>
                      {domain.name}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label htmlFor="profileId" className="block text-sm font-medium text-white mb-2">
                  Profile (Optional)
                </label>
                <select
                  id="profileId"
                  value={newCampaign.profileId}
                  onChange={(e) => setNewCampaign({ ...newCampaign, profileId: e.target.value })}
                  className="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:border-[#4F7FFF] focus:outline-none"
                >
                  <option value="">Select profile...</option>
                  {profiles.map((profile) => (
                    <option key={profile.id} value={profile.id}>
                      {profile.email}
                    </option>
                  ))}
                </select>
              </div>

              <div className="flex gap-3 pt-4">
                <button
                  type="button"
                  onClick={() => setShowCreateDialog(false)}
                  disabled={creating}
                  className="flex-1 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-white hover:bg-white/10 transition-colors disabled:opacity-50"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={creating}
                  className="flex-1 rounded-lg bg-[#4F7FFF] px-4 py-2 text-sm font-medium text-white hover:bg-[#3d6ee0] transition-colors disabled:opacity-50"
                >
                  {creating ? 'Creating...' : 'Create Campaign'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Delete Confirmation Modal */}
      {showDeleteDialog && campaignToDelete && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
          <div className="w-full max-w-md rounded-xl border border-white/10 bg-[#151823]">
            <div className="border-b border-white/10 px-6 py-4">
              <h2 className="text-lg font-semibold text-white">Delete Campaign</h2>
            </div>
            <div className="p-6">
              <p className="text-sm text-white/70 mb-6">
                Are you sure you want to delete <span className="font-semibold text-white">"{campaignToDelete.name}"</span>? 
                This action cannot be undone.
              </p>

              <div className="flex gap-3">
                <button
                  type="button"
                  onClick={() => {
                    setShowDeleteDialog(false);
                    setCampaignToDelete(null);
                  }}
                  disabled={deleting}
                  className="flex-1 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-white hover:bg-white/10 transition-colors disabled:opacity-50"
                >
                  Cancel
                </button>
                <button
                  type="button"
                  onClick={handleDeleteConfirm}
                  disabled={deleting}
                  className="flex-1 rounded-lg bg-red-500 px-4 py-2 text-sm font-medium text-white hover:bg-red-600 transition-colors disabled:opacity-50"
                >
                  {deleting ? 'Deleting...' : 'Delete'}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Preview Modal */}
      {previewCampaignId && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            zIndex: 9999,
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            backgroundColor: 'rgba(0, 0, 0, 0.9)',
            backdropFilter: 'blur(8px)',
            padding: '24px'
          }}
          onClick={() => setPreviewCampaignId(null)}
        >
          <div
            style={{
              display: 'flex',
              flexDirection: 'column',
              alignItems: 'center',
              gap: '24px',
              width: '100%',
              maxWidth: '1600px'
            }}
            onClick={(e) => e.stopPropagation()}
          >
            {/* Header */}
            <div style={{
              width: '100%',
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              color: '#FFFFFF'
            }}>
              <h2 style={{ fontSize: '20px', fontWeight: 600 }}>
                Preview: {previewCampaignName}
              </h2>
              <button
                onClick={() => setPreviewCampaignId(null)}
                style={{
                  padding: '10px 20px',
                  backgroundColor: '#151823',
                  border: '1px solid rgba(255, 255, 255, 0.1)',
                  borderRadius: '8px',
                  color: '#FFFFFF',
                  fontSize: '14px',
                  cursor: 'pointer',
                  transition: 'background-color 0.15s'
                }}
                onMouseEnter={(e) => e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.1)'}
                onMouseLeave={(e) => e.currentTarget.style.backgroundColor = '#151823'}
              >
                Close Preview
              </button>
            </div>

            {/* Preview Container */}
            <div style={{
              width: '100%',
              maxWidth: '1400px',
              height: '800px',
              backgroundColor: '#FFFFFF',
              borderRadius: '12px',
              overflow: 'hidden',
              boxShadow: '0 25px 50px -12px rgba(0, 0, 0, 0.5)'
            }}>
              <iframe
                src={`${process.env.NEXT_PUBLIC_BACKEND_URL || 'http://localhost:8000'}/api/preview/${previewCampaignId}`}
                style={{
                  width: '100%',
                  height: '100%',
                  border: 'none'
                }}
                title="Campaign Preview"
              />
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
