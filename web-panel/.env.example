# Frontend Environment Variables
# Copy this file to .env.local and configure

# API Base URL - NO HARDCODING!
# Option 1: Same domain (relative paths) - Leave empty or set to '/api'
NEXT_PUBLIC_API_URL=/api

# Option 2: Separate API subdomain (like the analyzed kit)
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Example for production:
# NEXT_PUBLIC_API_URL=https://api.cloud-dot-educ.org
